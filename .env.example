# ---------------------------------------------------------------------------
# YooPN Templates — local development environment
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be
# committed or shipped:
#
#     cp .env.example .env
#
# Production builds inject the same values at compile time instead, so no
# key is ever embedded in an artifact:
#
#     flutter build apk --release \
#       --dart-define=SUPABASE_URL=... \
#       --dart-define=SUPABASE_ANON_KEY=... \
#       --dart-define=REDIRECT_URL=...
#
# This file contains PLACEHOLDERS ONLY. No real credential belongs here.
# See SECURITY.md for the full policy.
# ---------------------------------------------------------------------------

# Supabase project — Dashboard → Project Settings → API
# The anon/publishable key is designed to be public (it is protected by
# Row Level Security). The `service_role` key is a SECRET: never put it in
# this file, in --dart-define, or anywhere in the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# OAuth / deep-link callback. Must match:
#   - Android manifest <data android:scheme="…" />  (…/AndroidManifest.xml)
#   - iOS CFBundleURLTypes                        (…/ios/Runner/Info.plist)
#   - Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
REDIRECT_URL=io.supabase.example://login-callback

# --- AdMob (optional) ------------------------------------------------------
# Unset in development: the app falls back to Google's public demo units
# (ca-app-pub-3940256099942544/…), which serve test ads and never earn money.
# Supply your own IDs for a real release build.
# ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
# ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY